# Career Radar Environment Configuration Template
# Copy this file to .env and fill in your details:

# Your candidate name as you want it to appear on exported resume PDFs
CANDIDATE_NAME=Jane Doe

# Optional: Google Apps Script Webhook URL for Google Docs / Drive PDF compilation
# Format: https://script.google.com/macros/s/YOUR_APPS_SCRIPT_DEPLOYMENT_ID/exec
APPS_SCRIPT_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_APPS_SCRIPT_DEPLOYMENT_ID/exec

# Optional: Custom Gemini Gem URL for tailored resume generation
# Format: https://gemini.google.com/gem/YOUR_GEM_ID
GEMINI_GEM_URL=https://gemini.google.com/app

# Port for local web dashboard
PORT=8050
